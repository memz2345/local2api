<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 「扫描二维码」：相机取景与 MLKit 识别 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 生物识别锁（Hail 同款应用锁）：BiometricPrompt 指纹 / 人脸 -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- 对话模拟页的语音输入（转文字）：SpeechRecognizer 收音 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Android 13+ 通知（实验室任务进度 / 提问 / 结果） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16+「实时更新」：进度为中心的通知要显式申请才可能被系统
         升级（置顶通知抽屉 / 锁屏 / 状态栏 chip）。非运行时权限，装上就有。 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- 忽略电池优化：实验室的 node / dsh 要长时间在后台跑 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <application
        android:label="Local2API"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- 通知上的按钮 / 直接回复 / 清除：只收本应用自己发的广播 -->
        <receiver
            android:name=".NotificationReceiver"
            android:exported="false" />
        <!-- Shizuku provider：启动时从 Shizuku 管理器拉 binder -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher：打开外部链接（Tailscale 下载页等） -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- speech_to_text：Android 11+ 包可见性，否则看不到系统识别服务 -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <!-- Shizuku：实验室以 shell 身份拉起 node（绕开 W^X 限制） -->
        <intent>
            <action android:name="moe.shizuku.manager.permission.API_V23"/>
        </intent>
        <!-- Custom Tabs：Android 11+ 包可见性，否则枚举不到装了 Chrome / Edge
             这类 Chromium 系浏览器的包（CustomTabsService 是它们声明的服务） -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService"/>
        </intent>
    </queries>
</manifest>
